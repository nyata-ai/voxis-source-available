{
  "realm": "voxis-oss",
  "enabled": true,
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "attributes": { "adminEventsExpiration": "7776000" },
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "roles": {
    "realm": [
      { "name": "voxis-user", "description": "Can use assigned Voxis organizations." },
      {
        "name": "voxis-admin",
        "description": "Operator-managed Voxis administration role. Includes voxis-user.",
        "composite": true,
        "composites": { "realm": ["voxis-user"] }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Keycloak baseline client scope required for OIDC dynamic registration.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "voxis-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "voxis-email-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" }
        },
        {
          "name": "voxis-email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email identity scope.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "${emailScopeConsentText}" },
      "protocolMappers": [
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": { "user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect profile identity scope.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "${profileScopeConsentText}" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "media:read",
      "description": "Voxis MCP permission: media:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: media:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "media:write",
      "description": "Voxis MCP permission: media:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: media:write" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "transcription:read",
      "description": "Voxis MCP permission: transcription:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: transcription:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "transcription:write",
      "description": "Voxis MCP permission: transcription:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: transcription:write" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "summary:read",
      "description": "Voxis MCP permission: summary:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: summary:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "summary:write",
      "description": "Voxis MCP permission: summary:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: summary:write" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "export:read",
      "description": "Voxis MCP permission: export:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: export:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "collection:read",
      "description": "Voxis MCP permission: collection:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: collection:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "collection:write",
      "description": "Voxis MCP permission: collection:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: collection:write" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "analysis:read",
      "description": "Voxis MCP permission: analysis:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: analysis:read" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    },
    {
      "name": "analysis:write",
      "description": "Voxis MCP permission: analysis:write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Voxis: analysis:write" },
      "protocolMappers": [{ "name": "voxis-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.client.audience": "voxis-oss-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }, { "name": "voxis-mcp-resource-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "__MCP_RESOURCE_AUDIENCE__", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "email"],
  "scopeMappings": [
    { "clientScope": "basic", "roles": ["voxis-user"] }
  ],
  "clients": [
    {
      "clientId": "voxis-oss-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["__OSS_PUBLIC_URL__/*"],
      "webOrigins": ["__OSS_PUBLIC_URL__"],
      "defaultClientScopes": ["basic", "email", "profile"],
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "voxis-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "voxis-oss-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "voxis-oss-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "voxis-oss-api-lookup",
      "description": "Lets the API confirm who owns an API key. Service account only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_USER_LOOKUP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-voxis-oss-api-lookup",
      "enabled": true,
      "serviceAccountClientId": "voxis-oss-api-lookup",
      "clientRoles": { "realm-management": ["view-users"] }
    }
  ]
}

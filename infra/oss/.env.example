# Copy to .env and run infra/oss/scripts/bootstrap.sh before starting services.
# The bootstrap script replaces every CHANGE_ME value. Do not commit .env.
COMPOSE_PROJECT_NAME=voxis-oss

# Images tested for this scaffold. See images.lock.yaml for sources and digests.
POSTGRES_IMAGE=postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
VOXIS_OSS_POSTGRES_IMAGE=voxis-oss-postgres:16.15-alpine3.24
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:6529db34610ce6328824218dce3bbe55c4ba4757bc5c8a09b5a4c746e28b6e9d
TEMURIN_IMAGE=eclipse-temurin@sha256:7fd597bf48c8bb13a7a3fb227f8366dec0423f78775d4b4f7e30409204af8627
VOXIS_OSS_KEYCLOAK_IMAGE=voxis-oss-keycloak:26.7.5-temurin21-noble
OPENBAO_IMAGE=quay.io/openbao/openbao@sha256:a60afafda36337abe833c4a63894bf1095098f29abea4091e7e555a33dd52889
VOXIS_OSS_OPENBAO_IMAGE=voxis-oss-openbao:2.6.3-security
CLAMAV_IMAGE=clamav/clamav@sha256:71fbb76b397cd84a90043caf1178a7f81bd0c131a031e7b0619afd721fbfad41
VOXIS_OSS_CLAMAV_IMAGE=voxis-oss-clamav:1.4.6-security
VOXIS_OSS_CADDY_IMAGE=voxis-oss-caddy:2.11.4-voxis.1-e2eee6a7

# Local operator-facing addresses. Use HTTPS behind a reverse proxy for a real deployment.
PUBLIC_BASE_URL=https://voxis-oss.example.invalid
PUBLIC_FRONTEND_URL=https://voxis-oss.example.invalid
CORS_ALLOWED_ORIGINS=https://voxis-oss.example.invalid
MCP_ALLOWED_ORIGINS=https://voxis-oss.example.invalid
PUBLIC_HOSTNAME=voxis-oss.example.invalid
TLS_EMAIL=operator@voxis-oss.example.invalid
OSS_KEYCLOAK_PUBLIC_URL=https://voxis-oss.example.invalid/auth
OSS_KEYCLOAK_FETCH_URL=http://keycloak:8080/auth
OSS_KEYCLOAK_REALM=voxis-oss
OSS_KEYCLOAK_WEB_CLIENT_ID=voxis-oss-web
OSS_KEYCLOAK_API_CLIENT_ID=voxis-oss-api
OSS_KEYCLOAK_ADDITIONAL_AUDIENCES=https://voxis-oss.example.invalid/mcp
# Host loopback port for the Keycloak admin console. Reach it only through an
# SSH tunnel: ssh -L 8081:127.0.0.1:8081 HOST, then open
# http://localhost:8081/auth/admin/ (use the same port on both ends).
OSS_KEYCLOAK_ADMIN_PORT=8081
# Comma-separated hosts that are allowed to register third-party MCP clients.
# List each approved client's egress IP address (where its registration
# requests come from) and the host names in its redirect URIs. Keycloak cannot
# resolve public names, so a host name alone never authorizes a sender. Use
# exact values; do not use a wildcard.
KEYCLOAK_DCR_TRUSTED_HOSTS=CHANGE_ME

# Installation-specific values written by bootstrap.sh. Keep them private.
POSTGRES_DB=voxis
POSTGRES_APP_USER=voxis
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_BOOTSTRAP_USER=voxis_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=CHANGE_ME
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_BOOTSTRAP_USER=keycloak_bootstrap
KEYCLOAK_DB_BOOTSTRAP_PASSWORD=CHANGE_ME
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=operator
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Service-account client the API uses to look up API-key owners. The realm
# import creates it with this ID; bootstrap.sh generates the secret.
KEYCLOAK_USER_LOOKUP_CLIENT_ID=voxis-oss-api-lookup
KEYCLOAK_USER_LOOKUP_CLIENT_SECRET=CHANGE_ME
MEDIA_STREAM_TOKEN_SECRET=CHANGE_ME

# Persistent local paths. Keep these on storage covered by the operator's backup policy.
LOCAL_STORAGE_DIR=./data/media
# Dedicated, encrypted scratch for upload spools and audio work. It must have
# at least 11 GiB free when it shares a filesystem with LOCAL_STORAGE_DIR for
# the default four 1 GiB upload slots. If the paths use separate filesystems,
# reserve at least 6 GiB here and 7 GiB on LOCAL_STORAGE_DIR.
# Mount it on the host with noexec,nosuid,nodev where supported.
LOCAL_SCRATCH_DIR=./data/scratch
OPENBAO_DATA_DIR=./data/openbao
OPENBAO_RECOVERY_DIR=./secrets/openbao
OPENBAO_BACKUP_DIR=./backups/openbao
KEYCLOAK_IMPORT_DIR=./keycloak

# The backend receives an AppRole after init-openbao.sh. It must not use a root token.
VAULT_ADDR=http://openbao:8200
VAULT_MOUNT_PATH=transit
VAULT_ROLE_ID=
VAULT_SECRET_ID=
ENCRYPTION_PROVIDER=vault

# Local model runtime. The measured CPU feasibility test starts one request slot
# at a 16,384-token context.
GEMMA_BASE_URL=http://gemma:8080/v1
GEMMA_ALLOW_HTTP_INTERNAL=true
GEMMA_MODEL=google/gemma-4-12B-it-qat-q4_0-gguf
GEMMA_MODEL_REVISION=29d097773436b69ff9feafd636ab4cf873786537
GEMMA_MODEL_FILE=gemma-4-12b-it-qat-q4_0.gguf
GEMMA_RUNTIME=llama.cpp
GEMMA_MODEL_SHA256=93567e57a8fe10b23569b9d9ec38cd005deedf71e29477c421a4b83f418a538b
GEMMA_RUNTIME_REVISION=5266f24da75dc449bd56cbed7addb9c8e4a6a73e
GEMMA_QUANTIZATION=Q4_0
GEMMA_MAX_CONTEXT_TOKENS=16384
# The CPU baseline observed a single model call near five minutes. Keep each
# request and its complete summary job bounded separately.
GEMMA_REQUEST_TIMEOUT_SECONDS=360
GEMMA_SUMMARY_JOB_TIMEOUT_MINUTES=60
GEMMA_MAX_ATTEMPTS=3
GEMMA_MAX_REQUEST_BYTES=4194304
GEMMA_MAX_RESPONSE_BYTES=8388608

# Retained optional capabilities are conservative by default. High-stakes is selected per summary job.
SUMMARY_HIGH_STAKES_ENABLED=false
SUMMARY_PROFILES_ENABLED=false
SUMMARY_SHARED_ANALYSIS_ENABLED=false
BAP_EXPORT_ENABLED=false

# Voxis Source-Available supports Speechmatics SaaS with the operator's own credentials.
TRANSCRIPTION_PROVIDER=speechmatics
SPEECHMATICS_MODE=saas
SPEECHMATICS_API_URL=https://eu1.asr.api.speechmatics.com
SPEECHMATICS_API_KEY=CHANGE_ME

ENVIRONMENT=production
BIND_ADDRESS=0.0.0.0
PORT=8080
TRUSTED_PROXIES=172.30.0.0/24
STORAGE_BACKEND=localfs
LOCAL_STORAGE_DIR_IN_CONTAINER=/var/lib/voxis/media
CLAMAV_ADDRESS=clamav:3310
SCAN_ENFORCEMENT=required
# Longest accepted recording or upload. Uncomment to change the default.
# MEDIA_MAX_DURATION=8h
# Longest live recording session, in whole hours. When it is longer than
# MEDIA_MAX_DURATION, recordings are limited to MEDIA_MAX_DURATION instead.
# RECORDING_MAX_DURATION_HOURS=8
REQUIRE_AUDIO_BINARIES=true
DEEPFILTER_BIN_PATH=/usr/local/bin/deep-filter
DEEPFILTER_ENABLED=false
MCP_RESOURCE_AUDIENCE=https://voxis-oss.example.invalid/mcp

# Compose builds both images from the reviewed edition sources. Record their
# resulting digests in the release manifest before deployment.
VOXIS_OSS_API_IMAGE=voxis-oss-api:local
VOXIS_OSS_WEB_IMAGE=voxis-oss-web:local

# init-openbao.sh writes the backup AppRole here. It can only snapshot Raft,
# only from inside the OpenBao container; backup.sh logs in with it and revokes
# the one-hour token when it finishes. The application AppRole cannot snapshot.
OPENBAO_BACKUP_APPROLE_FILE=./secrets/openbao/backup-approle.json

# age public key (age1...) of the offline backup identity. backup.sh refuses to
# run without it. Keep the matching identity file off this host.
BACKUP_AGE_RECIPIENT=

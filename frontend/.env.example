# Voxis Source-Available uses same-origin API and Keycloak paths by default.
# Leave VITE_API_URL unset for /api/v1, or set it when the API is served elsewhere.
# VITE_API_URL=/api/v1

# VITE_UPLOAD_URL (a separate origin for media uploads and recording chunks) is
# not supported in this edition. The bundled proxy's Content Security Policy
# allows requests only to the app's own origin (connect-src 'self'), so the
# browser would block uploads to another origin. Leave it unset.

# The bundled Keycloak deployment uses these values. Leave VITE_KEYCLOAK_URL
# unset for the same-origin /auth path, or set an intentional absolute issuer
# base URL for a split deployment.
VITE_KEYCLOAK_REALM=voxis-oss
VITE_KEYCLOAK_CLIENT_ID=voxis-oss-web
# VITE_KEYCLOAK_URL=https://keycloak.example.invalid/auth
